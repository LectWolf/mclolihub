AIHUB_IMAGE=ghcr.io/lectwolf/mclolihub:0.1.179.2
BIND_HOST=127.0.0.1
SERVER_PORT=8080
ONEPANEL_NETWORK=1panel-network
TZ=Asia/Shanghai
RUN_MODE=standard

# Use the PostgreSQL and Redis container names shown by 1Panel.
DATABASE_HOST=postgresql
DATABASE_PORT=5432
DATABASE_USER=sub2api
DATABASE_PASSWORD=replace_with_database_password
DATABASE_DBNAME=sub2api
DATABASE_SSLMODE=disable

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_admin_password
JWT_SECRET=replace_with_openssl_rand_hex_32
TOTP_ENCRYPTION_KEY=replace_with_openssl_rand_hex_32

# Optional. Public releases do not need a token; set one only to raise GitHub
# API rate limits.
UPDATE_GITHUB_TOKEN=

# Conservative defaults for a 2-core / 2-GB host shared with PostgreSQL/Redis.
GOMAXPROCS=2
GOMEMLIMIT=640MiB
DATABASE_MAX_OPEN_CONNS=15
DATABASE_MAX_IDLE_CONNS=5
REDIS_POOL_SIZE=64
REDIS_MIN_IDLE_CONNS=5
AIHUB_MEMORY_LIMIT=768m
AIHUB_MEMORY_RESERVATION=256m
AIHUB_CPU_LIMIT=1.5
